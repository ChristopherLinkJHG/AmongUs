{
  "name": "amongus-browser-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run typecheck && vite build && node --experimental-transform-types server/index.ts",
    "level:from-svg": "node --experimental-transform-types tools/svg-to-level.ts",
    "level": "node --experimental-transform-types tools/svg-to-level.ts",
    "level:help": "node --experimental-transform-types tools/svg-to-level.ts --help",
    "typecheck": "tsc",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "server": "node --experimental-transform-types server/index.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.19",
    "colyseus": "^0.17.8",
    "cors": "^2.8.6",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.35",
    "concurrently": "^9.2.1",
    "fast-xml-parser": "^5.5.9",
    "phaser": "^3.90.0",
    "vite": "^8.0.3"
  }
}
